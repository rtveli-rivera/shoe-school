# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp

# Native build (Capacitor): dev-only, regenerated by `npm install` / sync-web
node_modules/
www/
# Android build outputs (the android/ project itself is committed)
android/app/build/
android/build/
android/.gradle/
android/local.properties
# Intermediate icon rasters (regenerated by scripts/gen-icons.mjs)
assets/*.png

# Built APK copies
dist/
